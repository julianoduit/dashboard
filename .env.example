# Copie para .env e preencha. Nunca versione o .env.

# --- Banco ---
POSTGRES_USER=duit
POSTGRES_PASSWORD=duit
POSTGRES_DB=duit_dashboard
POSTGRES_PORT=5432
DATABASE_URL=postgres://duit:duit@localhost:5432/duit_dashboard
# Usado só pelos testes automatizados (o conteúdo é apagado a cada execução).
TEST_DATABASE_URL=postgres://duit:duit@localhost:5432/duit_dashboard_test

# --- Google Ads API (somente leitura) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID da MCC, só dígitos (sem traços). Vai no header login-customer-id de toda chamada.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26

# --- Sincronização ---
# Expressão cron (minuto hora dia mês dia-da-semana), interpretada no fuso SYNC_TZ.
SYNC_CRON=0 5 * * *
SYNC_TZ=America/Sao_Paulo
SYNC_WINDOW_DAYS=30
SYNC_BACKFILL_MONTHS=13
# false desliga o agendamento automático (útil em dev).
SYNC_SCHEDULER_ENABLED=true

# --- Servidor ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
